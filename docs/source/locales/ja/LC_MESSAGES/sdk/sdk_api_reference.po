msgid "Dynamic Key Management"
msgstr "ダイナミック キーの管理"

#: ../../source/sdk/sdk_api_reference.md:394
msgid ""
"The `plugin.dynamickey` object provides advanced key management "
"capabilities."
msgstr "`plugin.dynamickey` オブジェクトが、高度なキー管理機能を提供します。"

#: ../../source/sdk/sdk_api_reference.md:396
msgid "plugin.dynamickey.clear(serialNumber, key)"
msgstr "plugin.dynamickey.clear(serialNumber, key)"

