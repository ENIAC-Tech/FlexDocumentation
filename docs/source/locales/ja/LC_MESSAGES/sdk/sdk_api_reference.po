msgstr "`width` (数値): キーの幅 (ピクセル単位) (60 ～ 1000)"

#: ../../source/sdk/sdk_api_reference.md:414
msgid "`userData` (object): Custom data associated with the key"
msgstr "`userData` (オブジェクト): キーに関連付けられたカスタム データ"

#: ../../source/sdk/sdk_api_reference.md:428
msgid "plugin.dynamickey.remove(serialNumber, key, index)"
msgstr "plugin.dynamickey.remove(serialNumber, key, index)"

#: ../../source/sdk/sdk_api_reference.md:430
msgid "Removes a dynamic key at the specified index."
msgstr "指定したインデックスのダイナミック キーを削除します。"

#: ../../source/sdk/sdk_api_reference.md:436
msgid "plugin.dynamickey.move(serialNumber, key, srcIndex, dstIndex)"
msgstr "plugin.dynamickey.move(serialNumber, key, srcIndex, dstIndex)"

#: ../../source/sdk/sdk_api_reference.md:438
msgid "Moves a dynamic key from one position to another."
msgstr "ダイナミック キーの位置を移動します。"

#: ../../source/sdk/sdk_api_reference.md:444
msgid "plugin.dynamickey.setWidth(serialNumber, key, width)"
msgstr "plugin.dynamickey.setWidth(serialNumber, key, width)"

#: ../../source/sdk/sdk_api_reference.md:446
msgid "Changes the width of the dynamic key container."
msgstr "ダイナミック キー コンテナの幅を変更します。"

#: ../../source/sdk/sdk_api_reference.md:452
msgid ""
"plugin.dynamickey.draw(serialNumber, key, index, backgroundType, "
"backgroundData, width)"
msgstr ""
"plugin.dynamickey.draw(serialNumber, key, index, backgroundType, "
"backgroundData, width)"

#: ../../source/sdk/sdk_api_reference.md:454
msgid "Updates the visual appearance of a specific dynamic key."
msgstr "指定したダイナミック キーの見た目を更新します。"

#: ../../source/sdk/sdk_api_reference.md:467
msgid "plugin.dynamickey.update(serialNumber, key, index, userData)"
msgstr "plugin.dynamickey.update(serialNumber, key, index, userData)"

#: ../../source/sdk/sdk_api_reference.md:469
msgid "Updates the user data for a dynamic key."
msgstr "ダイナミック キーのユーザーデータを更新します。"

#: ../../source/sdk/sdk_api_reference.md:475
msgid "plugin.dynamickey.refresh(serialNumber, key)"
msgstr "plugin.dynamickey.refresh(serialNumber, key)"

#: ../../source/sdk/sdk_api_reference.md:477
msgid "Refreshes the dynamic key display (recommended after width changes)."
msgstr "ダイナミック キーの表示を更新します（幅変更後の呼び出しを推奨）。"

#: ../../source/sdk/sdk_api_reference.md:483
msgid "Event Handling"
msgstr "イベント処理"

#: ../../source/sdk/sdk_api_reference.md:485
msgid "Plugin Events"
msgstr "プラグイン イベント"

#: ../../source/sdk/sdk_api_reference.md:487
msgid "'plugin.alive'"
msgstr "'plugin.alive'"

#: ../../source/sdk/sdk_api_reference.md:489
msgid "Triggered when keys are loaded and ready for interaction."
msgstr "キーが読み込まれ、操作可能になったときに発火します。"

#: ../../source/sdk/sdk_api_reference.md:508
msgid "'plugin.dead'"
msgstr "'plugin.dead'"

#: ../../source/sdk/sdk_api_reference.md:510
msgid "Triggered when plugin keys are destroyed"
msgstr "プラグインのキーが破棄されたときに発火します。"

#: ../../source/sdk/sdk_api_reference.md:523
msgid "'plugin.data'"
msgstr "'plugin.data'"

#: ../../source/sdk/sdk_api_reference.md:525
msgid "Triggered when users interact with keys."
msgstr "ユーザーがキーを操作したときに発火します。"

#: ../../source/sdk/sdk_api_reference.md:543
msgid "'plugin.config.updated'"
