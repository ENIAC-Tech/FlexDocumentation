msgid "Adds a new dynamic key."
msgstr "新しいダイナミック キーを追加します。"

#: ../../source/sdk/sdk_api_reference.md:410
msgid "`index` (number): Position to insert the key"
msgstr "`index` (number): キーを挿入する位置"

#: ../../source/sdk/sdk_api_reference.md:411
msgid "`backgroundType` (string): 'base64' or 'draw'"
msgstr "`backgroundType` (文字列): 'base64' または 'draw'"

#: ../../source/sdk/sdk_api_reference.md:412
msgid "`backgroundData` (string): Image data or key object"
msgstr "`backgroundData` (文字列): 画像データまたはキーオブジェクト"

