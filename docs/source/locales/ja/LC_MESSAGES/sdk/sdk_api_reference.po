msgid "Removes all dynamic keys from a container."
msgstr "コンテナ内のダイナミック キーをすべて削除します。"

#: ../../source/sdk/sdk_api_reference.md:404
msgid ""
"plugin.dynamickey.add(serialNumber, key, index, backgroundType, "
