msgstr "1743992112936"

#: ../../source/flexdesigner/getting_started.md:22
msgid "**Add a Key**"
msgstr "**キーを追加**"

#: ../../source/flexdesigner/getting_started.md:24
msgid "![1743992435420](image/getting_started/1743992435420.png)"
msgstr "![1743992435420](image/getting_started/1743992435420.png)"

